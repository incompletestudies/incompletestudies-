---
layout: default
title: The Unfinished Archive
permalink: /
---

<div class="home-hero">
  <div class="home-left">
    <div>
      <div class="home-eyebrow">The Unfinished Archive</div>
      <h1 class="home-title">
        Journal of Incomplete Studies
      </h1>
      <div class="home-season-badge">
        Season {{ site.current_season | default: "1" }} · Autumn 2026 → ongoing
      </div>
      
      {% comment %}─── Tagline ───{% endcomment %}
      <div style="font-family:var(--text);font-size:13px;font-style:italic;color:var(--muted);margin-top:-0.5rem;margin-bottom:1.5rem;max-width:400px;">
        A serial research publication for thought still in motion
      </div>

      {% comment %}─── Search ───{% endcomment %}
      <div class="home-search">
        <input type="text" placeholder="Search authors, projects, installments..." 
               style="width:100%;background:var(--void2);border:1px solid var(--rule);padding:0.5rem 1rem;border-radius:4px;color:var(--cream);font-family:var(--text);font-size:13px;font-style:italic;transition:border-color 0.2s;"
               onfocus="this.style.borderColor='var(--gold-dim)'" 
               onblur="this.style.borderColor='var(--rule)'">
      </div>
    </div>

    <div>
      <div style="font-family:var(--mono);font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);margin-bottom:0.8rem;display:flex;justify-content:space-between;align-items:center;">
        <span>Active projects</span>
        <span style="color:var(--muted);font-size:7px;">{{ site.projects | size }} total</span>
      </div>
      
      {% comment %}─── PROJECT GRID ───{% endcomment %}
      <div class="home-project-grid">
        {% if site.projects and site.projects.size > 0 %}
          {% for project in site.projects %}
            <div class="home-project-card" onclick="location.href='{{ site.baseurl }}{{ project.url }}'" role="link" tabindex="0">
              <span class="home-project-id">{{ project.id | default: "P" }}{{ forloop.index }}</span>
              <h3 class="home-project-title">{{ project.title }}</h3>
              <span class="home-project-status 
                {% if project.status == 'Ongoing' %}live
                {% elsif project.status == 'New' %}new
                {% endif %}">
                {{ project.status | default: "Active" }}
              </span>
            </div>
          {% endfor %}
        {% else %}
          <div class="home-project-card" style="opacity:0.5;cursor:default;grid-column:1/-1;text-align:center;padding:2rem 0;">
            <span style="color:var(--mid);font-style:normal;font-family:var(--text);font-size:13px;">No projects yet — check back soon</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="home-right">
    <div class="home-temporal">
      <div class="home-bg-year">{{ site.time | date: "%Y" }}</div>
      <div class="home-latest">
        {% assign latest_post = site.posts | first %}
        {% if latest_post %}
          {% assign latest_project = site.projects | where: "slug", latest_post.project_slug | first %}
          {% assign latest_author = site.people | where: "slug", latest_post.author_slug | first %}
          
          <div class="home-latest-eyebrow">
            <span style="color:var(--gold);">✦</span> Latest installment · 
            {{ latest_post.date | date: "%b %Y" }} · 
            {% if latest_project.id %}
              {{ latest_project.id }}
            {% else %}
              {{ latest_post.project_slug | default: "P–?" }}
            {% endif %}
            Inst. {{ latest_post.installment | default: "?" }}
          </div>
          
          <div class="home-latest-title">
            <a href="{{ site.baseurl }}{{ latest_post.url }}" style="color:var(--bright);text-decoration:none;transition:color 0.2s;">
              {{ latest_post.title }}
            </a>
          </div>
          
          <div class="home-latest-meta">
            {% if latest_author %}
              {{ latest_author.title }}
            {% elsif latest_post.author %}
              {{ latest_post.author }}
            {% else %}
              {{ latest_post.author_slug | default: "Anonymous" }}
            {% endif %}
            ·
            {% if latest_project %}
              {{ latest_project.title }}
            {% elsif latest_post.project %}
              {{ latest_post.project }}
            {% else %}
              {{ latest_post.project_slug | default: "Uncategorized" }}
            {% endif %}
          </div>
          
          <div class="home-latest-excerpt">
            <a href="{{ site.baseurl }}{{ latest_post.url }}" style="color:var(--pale);text-decoration:none;transition:color 0.2s;">
              {{ latest_post.excerpt | strip_html | truncatewords: 30 }}
            </a>
          </div>
          
          {% comment %}─── CONTINUE READING CTA ───{% endcomment %}
          <div style="margin-top:1rem;">
            <a href="{{ site.baseurl }}{{ latest_post.url }}" class="jump-link" style="font-family:var(--mono);font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);border-bottom:1px solid var(--gold-dim);padding-bottom:2px;display:inline-block;text-decoration:none;transition:opacity 0.12s;">
              Continue Reading →
            </a>
          </div>
        {% else %}
          <div class="home-latest-eyebrow">No installments yet</div>
          <div class="home-latest-title">Check back soon</div>
          <div class="home-latest-excerpt" style="color:var(--mid);font-style:normal;">
            The first installment will appear here.
          </div>
        {% endif %}
      </div>
    </div>

    <div class="home-timeline">
      {% if site.posts and site.posts.size > 0 %}
        {% assign total_posts = site.posts.size %}
        {% assign display_posts = total_posts | at_most: 3 %}
        
        {% for post in site.posts limit:3 %}
          <div class="timeline-inst {% if forloop.first %}current{% else %}done{% endif %}" onclick="location.href='{{ site.baseurl }}{{ post.url }}'" role="link" tabindex="0">
            <div class="timeline-inst-num">
              I·{% if post.installment < 10 %}0{% endif %}{{ post.installment | default: "?" }} 
              {{ post.date | date: "%b'%y" }}
            </div>
            <div class="timeline-inst-title">{{ post.title }}</div>
          </div>
        {% endfor %}
        
        {% if total_posts > 3 %}
          <div class="timeline-inst view-all" onclick="location.href='{{ site.baseurl }}/installments/'" role="link" tabindex="0">
            <div class="timeline-inst-num" style="color:var(--gold);">+{{ total_posts | minus: 3 }}</div>
            <div class="timeline-inst-title" style="color:var(--gold);">View all →</div>
          </div>
        {% endif %}
      {% else %}
        <div class="timeline-inst" style="opacity:0.3;cursor:default;flex:1;text-align:center;">
          <div class="timeline-inst-num">—</div>
          <div class="timeline-inst-title" style="color:var(--mid);font-style:normal;">No installments yet</div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  /* ─── Homepage improvements ─── */

  /* ─── Project Grid ─── */
  .home-project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .home-project-card {
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    background: rgba(255, 255, 255, 0.01);
  }

  .home-project-card:hover {
    border-color: var(--gold-dim);
    background: rgba(255, 255, 255, 0.03);
    transform: translateY(-2px);
  }

  .home-project-id {
    font-family: var(--mono);
    font-size: 7px;
    color: var(--ash);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.2rem;
  }

  .home-project-title {
    font-family: var(--display);
    font-size: 13px;
    font-style: italic;
    font-weight: 700;
    color: var(--cream);
    margin: 0;
    line-height: 1.3;
  }

  .home-project-status {
    font-family: var(--mono);
    font-size: 6px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-top: 0.3rem;
    border: 1px solid var(--rule);
    padding: 0.05rem 0.4rem;
    border-radius: 2px;
  }

  .home-project-status.live {
    color: var(--sage);
    border-color: var(--sage-dim);
  }

  .home-project-status.new {
    color: var(--gold);
    border-color: var(--gold-dim);
  }

  /* ─── Search ─── */
  .home-search {
    margin-bottom: 1.5rem;
  }

  .home-search input::placeholder {
    color: var(--ash);
  }

  .home-search input:focus {
    border-color: var(--gold-dim);
    outline: none;
  }

  /* ─── Timeline View All ─── */
  .timeline-inst.view-all {
    border: 1px dashed var(--rule);
    background: transparent;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .timeline-inst.view-all:hover {
    border-color: var(--gold-dim);
    background: rgba(201, 168, 76, 0.03);
  }

  /* ─── Mobile ─── */
  @media (max-width: 768px) {
    .home-hero {
      grid-template-columns: 1fr !important;
      min-height: auto !important;
      display: flex !important;
      flex-direction: column-reverse !important;
    }

    .home-left {
      border-right: none !important;
      padding: 1.5rem 1.5rem 2rem !important;
      order: 2 !important;
    }

    .home-right {
      display: block !important;
      order: 1 !important;
    }

    .home-temporal {
      padding: 1.5rem !important;
    }

    .home-bg-year {
      font-size: clamp(120px, 25vw, 180px) !important;
      top: -0.1em !important;
      right: -0.05em !important;
    }

    .home-title {
      font-size: clamp(36px, 8vw, 52px) !important;
    }

    .home-season-badge {
      font-size: 8px !important;
      padding: 4px 10px !important;
      margin-bottom: 1rem !important;
      display: inline-flex !important;
    }

    .home-project-grid {
      grid-template-columns: 1fr 1fr;
    }

    .home-project-title {
      font-size: 12px !important;
    }

    .home-latest-title {
      font-size: clamp(18px, 4vw, 24px) !important;
    }

    .home-latest-excerpt {
      font-size: 12px !important;
      max-width: 100% !important;
    }

    .home-timeline {
      padding: 0.8rem 1rem !important;
      flex-wrap: wrap !important;
      gap: 0.5rem !important;
    }

    .timeline-inst {
      flex: 1 1 calc(50% - 0.5rem) !important;
      padding: 0.4rem 0.6rem !important;
      border-right: none !important;
      border-bottom: 1px solid var(--rule) !important;
      text-align: center !important;
    }

    .timeline-inst:last-child {
      border-bottom: none !important;
    }

    .timeline-inst-num {
      font-size: 7px !important;
    }

    .timeline-inst-title {
      font-size: 10px !important;
    }
  }

  @media (max-width: 480px) {
    .home-left {
      padding: 1rem 1rem 1.5rem !important;
    }

    .home-temporal {
      padding: 1rem !important;
    }

    .home-title {
      font-size: clamp(28px, 7vw, 36px) !important;
    }

    .home-season-badge {
      font-size: 7px !important;
      padding: 3px 8px !important;
    }

    .home-project-grid {
      grid-template-columns: 1fr;
    }

    .home-latest-eyebrow {
      font-size: 7px !important;
    }

    .home-latest-meta {
      font-size: 8px !important;
    }

    .home-latest-excerpt {
      font-size: 11px !important;
    }

    .timeline-inst {
      flex: 1 1 100% !important;
    }
  }
</style>