---
layout: default
---
{% assign author = site.people | where: "slug", page.author | first %}
{% assign project = site.projects | where: "slug", page.project | first %}
{% assign season = site.seasons | where: "code", page.season | first %}

{% assign project_posts = site.posts | where: "project", page.project | sort: "date" %}
{% assign current_index = 0 %}
{% for p in project_posts %}{% if p.url == page.url %}{% assign current_index = forloop.index0 %}{% endif %}{% endfor %}
{% assign prev_post = nil %}
{% assign next_post = nil %}
{% if current_index > 0 %}
  {% assign prev_index = current_index | minus: 1 %}
  {% assign prev_post = project_posts[prev_index] %}
{% endif %}
{% assign next_index = current_index | plus: 1 %}
{% if next_index < project_posts.size %}
  {% assign next_post = project_posts[next_index] %}
{% endif %}

{% assign same_month = page.date | date: "%Y-%m" %}
{% assign resonant_posts = site.posts | where_exp: "p", "p.url != page.url" | where_exp: "p", "p.project != page.project" %}
{% assign resonant_month_posts = "" | split: "" %}
{% for p in resonant_posts %}
  {% assign p_month = p.date | date: "%Y-%m" %}
  {% if p_month == same_month %}{% assign resonant_month_posts = resonant_month_posts | push: p %}{% endif %}
{% endfor %}

<div class="section-wrap">
  <div class="col-head">
    <span class="col-head-title">{{ page.title }}</span>
    <span class="col-head-meta">{{ project.id }} · Inst. {{ page.installment }} · {{ page.date | date: "%B %d, %Y" }}</span>
  </div>
  <div class="feed-wrap" style="padding-top:2.5rem;padding-bottom:4rem">
    <div class="feed-proj-tag">
      <a href="{{ site.baseurl }}/projects/{{ project.slug }}/" style="color:inherit">{{ project.title }}</a>
    </div>
    <div class="feed-author">
      {% if author %}<a href="{{ site.baseurl }}/authors/{{ author.slug }}/" style="color:inherit">{{ author.title }}</a>{% endif %}
      {% if season %} · <a href="{{ site.baseurl }}/seasons/{{ season.slug }}/" style="color:inherit">{{ season.title }}</a>{% endif %}
    </div>
    {% if page.badge %}
      <div style="margin:0.8rem 0 2rem"><span class="pill {{ page.badge_class }}">{{ page.badge }}</span></div>
    {% endif %}
    <div style="max-width:720px;font-family:var(--text);font-size:14px;font-style:italic;color:var(--pale);line-height:1.9">
      {{ content }}
    </div>

    {% if prev_post or next_post %}
      <div style="display:flex;justify-content:space-between;gap:2rem;flex-wrap:wrap;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--rule)">
        <div>
          {% if prev_post %}
            <div style="font-family:var(--mono);font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-bottom:0.4rem">← Previous in {{ project.title }}</div>
            <a href="{{ site.baseurl }}{{ prev_post.url }}" style="color:inherit;font-family:var(--mono);font-size:10px">Inst. {{ prev_post.installment }} · {{ prev_post.title }}</a>
          {% endif %}
        </div>
        <div style="text-align:right">
          {% if next_post %}
            <div style="font-family:var(--mono);font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-bottom:0.4rem">Next in {{ project.title }} →</div>
            <a href="{{ site.baseurl }}{{ next_post.url }}" style="color:inherit;font-family:var(--mono);font-size:10px">Inst. {{ next_post.installment }} · {{ next_post.title }}</a>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if resonant_month_posts.size > 0 %}
      <div class="cr-block-title" style="margin-top:2.5rem">Also published {{ page.date | date: "%B %Y" }}</div>
      <ul class="cr-list">
        {% for p in resonant_month_posts limit:3 %}
          {% assign p_project = site.projects | where: "slug", p.project | first %}
          <li><a href="{{ site.baseurl }}{{ p.url }}" style="color:inherit">{{ p.title }}</a>{% if p_project %} — <a href="{{ site.baseurl }}/projects/{{ p_project.slug }}/" style="color:inherit">{{ p_project.title }}</a>{% endif %}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>
