---
layout: default
---
{% assign author = site.people | where: "slug", page.author | first %}

{% comment %}─── FIX: Try both project_slug and project ───{% endcomment %}
{% assign installments_by_slug = site.posts | where: "project_slug", page.slug %}
{% assign installments_by_title = site.posts | where: "project", page.slug %}
{% if installments_by_slug.size > 0 %}
  {% assign installments = installments_by_slug | sort: "date" | reverse %}
{% elsif installments_by_title.size > 0 %}
  {% assign installments = installments_by_title | sort: "date" | reverse %}
{% else %}
  {% assign installments = "" | split: "" %}
{% endif %}

{% assign season = site.seasons | where: "code", page.season | first %}
{% if page.contributors %}
  {% assign contributor_slugs = page.contributors %}
{% else %}
  {% assign contributor_slugs = page.author | split: "," %}
{% endif %}
{% assign contributors = "" | split: "" %}
{% for slug in contributor_slugs %}
  {% assign person = site.people | where: "slug", slug | first %}
  {% if person %}{% assign contributors = contributors | push: person %}{% endif %}
{% endfor %}
{% assign sibling_projects = site.projects | where: "season", page.season | where_exp: "p", "p.slug != page.slug" %}

<div class="section-wrap">
  <div class="col-head">
    <span class="col-head-title">{{ page.title }}</span>
    <span class="col-head-meta">{{ page.id }} · {{ page.last_updated }}</span>
  </div>

  <div class="proj-main" style="padding:2.5rem var(--gutter) 4rem">
    <div style="font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:0.04em;margin-bottom:2rem">
      {% for person in contributors %}<a href="{{ site.baseurl }}/authors/{{ person.slug }}/" style="color:inherit">{{ person.title }} · {{ person.role }}, {{ person.discipline | downcase }}</a>{% unless forloop.last %} &nbsp;+&nbsp; {% endunless %}{% endfor %}
    </div>

    <div style="font-family:var(--text);font-size:14px;font-style:italic;color:var(--pale);line-height:1.8;margin-bottom:2rem;max-width:720px">
      {{ page.abstract }}
    </div>

    <div style="display:flex;gap:2rem;flex-wrap:wrap;margin-bottom:1rem">
      <div><strong>Status:</strong> {{ page.status }}</div>
      <div><strong>Progress:</strong> {{ page.installments }} of {{ page.total_installments }} installments</div>
      <div><strong>Season:</strong> {% if season %}<a href="{{ site.baseurl }}/seasons/{{ season.slug }}/" style="color:inherit">{{ page.season }}</a>{% else %}{{ page.season }}{% endif %}</div>
    </div>

    <div class="prog-dots" style="justify-content:flex-start;margin-bottom:2.5rem">
      {% for i in (1..page.total_installments) %}
        <div class="prog-dot {% if i < page.installments %}done{% elsif i == page.installments %}now{% endif %}"></div>
      {% endfor %}
    </div>

    <div class="about-body-text">
      {{ content }}
    </div>

    {% if installments.size > 0 %}
      <div class="cr-block-title" style="margin-top:2.5rem">Installments</div>
      {% for post in installments %}
        <div class="detail-inst-row">
          <div class="detail-inst-num">Inst. {{ post.installment }}<span class="detail-inst-date">{{ post.date | date: "%Y-%m-%d" }}</span></div>
          <div>
            <div class="detail-inst-title"><a href="{{ site.baseurl }}{{ post.url }}" style="color:inherit">{{ post.title }}</a></div>
            <div class="detail-inst-excerpt">{{ post.excerpt | strip_html }}</div>
          </div>
          <div>{% if post.badge %}<span class="pill {{ post.badge_class }}">{{ post.badge }}</span>{% endif %}</div>
        </div>
      {% endfor %}
    {% endif %}

    {% if sibling_projects.size > 0 %}
      <div class="cr-block-title" style="margin-top:2.5rem">Also in {{ page.season }}</div>
      <ul class="cr-list">
        {% for sib in sibling_projects %}
          {% assign sib_author = site.people | where: "slug", sib.author | first %}
          <li><a href="{{ site.baseurl }}/projects/{{ sib.slug }}/" style="color:inherit">{{ sib.title }}</a>{% if sib_author %} — <a href="{{ site.baseurl }}/authors/{{ sib_author.slug }}/" style="color:inherit">{{ sib_author.title }}</a>{% endif %}</li>
        {% endfor %}
      </ul>
    {% endif %}

    <div style="margin-top:2.5rem">
      <a href="{{ site.baseurl }}/projects/#{{ page.slug }}" style="font-family:var(--mono);font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--mid);border-bottom:1px solid var(--ash);padding-bottom:2px">← Back to all projects</a>
    </div>
  </div>
</div>