---
layout: null
---
[
  {% assign first = true %}

  {% for post in site.posts %}
    {% unless first %},{% endunless %}{% assign first = false %}
    {
      "title": {{ post.title | default: post.slug | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "category": "Post",
      "content": {{ post.content | strip_html | strip_newlines | jsonify }}
    }
  {% endfor %}

  {% for page in site.pages %}
    {% if page.title and page.url != "/search.json" %}
      {% unless first %},{% endunless %}{% assign first = false %}
      {
        "title": {{ page.title | jsonify }},
        "url": {{ page.url | relative_url | jsonify }},
        "category": "Page",
        "content": {{ page.content | strip_html | strip_newlines | jsonify }}
      }
    {% endif %}
  {% endfor %}

  {% for item in site.projects %}
    {% unless first %},{% endunless %}{% assign first = false %}
    {
      "title": {{ item.title | default: item.slug | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "category": "Project",
      "content": {{ item.content | strip_html | strip_newlines | jsonify }}
    }
  {% endfor %}

  {% for item in site.seasons %}
    {% unless first %},{% endunless %}{% assign first = false %}
    {
      "title": {{ item.title | default: item.slug | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "category": "Season",
      "content": {{ item.content | strip_html | strip_newlines | jsonify }}
    }
  {% endfor %}

  {% for item in site.people %}
    {% unless first %},{% endunless %}{% assign first = false %}
    {
      "title": {{ item.title | default: item.slug | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "category": "Author",
      "content": {{ item.content | strip_html | strip_newlines | jsonify }}
    }
  {% endfor %}
]