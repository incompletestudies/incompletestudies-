---
layout: default
title: Style Guide
permalink: /style-guide/
---

<div class="section-wrap">
  <div class="col-head">
    <span class="col-head-title">Style Guide</span>
    <span class="col-head-meta">Component Library v1.0</span>
  </div>

  <!-- ─── QUICK NAVIGATION ─── -->
  <div class="style-toc">
    <span class="style-toc-label">Jump to:</span>
    <a href="#typography">Typography</a>
    <a href="#colors">Colors</a>
    <a href="#badges">Badges</a>
    <a href="#cards">Cards</a>
    <a href="#tags">Tags</a>
    <a href="#links">Links</a>
    <a href="#breadcrumb">Breadcrumb</a>
    <a href="#headers">Headers</a>
    <a href="#grids">Grids</a>
    <a href="#spacing">Spacing</a>
    <a href="#interactive">Interactive</a>
  </div>

  <div class="style-guide-body">
    
    <!-- ─── TYPOGRAPHY ─── -->
    <section class="style-section" id="typography">
      <h2 class="style-section-title">Typography</h2>
      
      <div class="style-grid">
        <div class="style-item">
          <h3 class="style-label">Display Font</h3>
          <p class="style-preview display-preview">
            The Journal of Incomplete Studies
          </p>
          <p class="style-code">font-family: var(--display)</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Text Font</h3>
          <p class="style-preview text-preview">
            A serial research publication for ideas still in motion.
          </p>
          <p class="style-code">font-family: var(--text)</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Mono Font</h3>
          <p class="style-preview mono-preview">
            Installment 03 · January 2026
          </p>
          <p class="style-code">font-family: var(--mono)</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Script Font</h3>
          <p class="style-preview script-preview">
            Notes in the margin
          </p>
          <p class="style-code">font-family: var(--script)</p>
        </div>
      </div>
    </section>

    <!-- ─── COLORS ─── -->
    <section class="style-section" id="colors">
      <h2 class="style-section-title">Colors</h2>
      
      <div class="style-grid">
        <div class="color-swatch" style="background: var(--void); color: var(--cream);">
          <span class="color-name">--void</span>
          <span class="color-hex">#0c0b09</span>
        </div>
        <div class="color-swatch" style="background: var(--void2); color: var(--cream);">
          <span class="color-name">--void2</span>
          <span class="color-hex">#1a1714</span>
        </div>
        <div class="color-swatch" style="background: var(--void3); color: var(--cream);">
          <span class="color-name">--void3</span>
          <span class="color-hex">#28231e</span>
        </div>
        <div class="color-swatch" style="background: var(--cream); color: var(--void);">
          <span class="color-name">--cream</span>
          <span class="color-hex">#e8dfd0</span>
        </div>
        <div class="color-swatch" style="background: var(--pale); color: var(--void);">
          <span class="color-name">--pale</span>
          <span class="color-hex">#c8bfae</span>
        </div>
        <div class="color-swatch" style="background: var(--muted); color: var(--void);">
          <span class="color-name">--muted</span>
          <span class="color-hex">#9e9282</span>
        </div>
        <div class="color-swatch" style="background: var(--mid); color: var(--cream);">
          <span class="color-name">--mid</span>
          <span class="color-hex">#7a6e60</span>
        </div>
        <div class="color-swatch" style="background: var(--ash); color: var(--cream);">
          <span class="color-name">--ash</span>
          <span class="color-hex">#5a4f44</span>
        </div>
        <div class="color-swatch" style="background: var(--gold); color: var(--void);">
          <span class="color-name">--gold</span>
          <span class="color-hex">#d4b87a</span>
        </div>
        <div class="color-swatch" style="background: var(--gold-dim); color: var(--cream);">
          <span class="color-name">--gold-dim</span>
          <span class="color-hex">#a68b5c</span>
        </div>
        <div class="color-swatch" style="background: var(--sage); color: var(--void);">
          <span class="color-name">--sage</span>
          <span class="color-hex">#8aaa7a</span>
        </div>
        <div class="color-swatch" style="background: var(--rust); color: var(--cream);">
          <span class="color-name">--rust</span>
          <span class="color-hex">#c06a4a</span>
        </div>
      </div>
    </section>

    <!-- ─── BADGES ─── -->
    <section class="style-section" id="badges">
      <h2 class="style-section-title">Badges</h2>
      
      <div class="style-grid style-grid-badges">
        <div class="style-item">
          <h3 class="style-label">Project Status</h3>
          <div class="style-badge-row">
            <span class="sg-badge sg-badge-new">New</span>
            <span class="sg-badge sg-badge-active">Active</span>
            <span class="sg-badge sg-badge-on-hold">On Hold</span>
            <span class="sg-badge sg-badge-archived">Archived</span>
          </div>
          <p class="style-code">.badge .badge-{status}</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Installment Status</h3>
          <div class="style-badge-row">
            <span class="sg-badge sg-badge-first">First Inst.</span>
            <span class="sg-badge sg-badge-revised">Revised</span>
            <span class="sg-badge sg-badge-last">Last Inst.</span>
          </div>
          <p class="style-code">.badge .badge-{type}</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Pills</h3>
          <div class="style-badge-row">
            <span class="sg-pill sg-pill-live">● Live</span>
            <span class="sg-pill sg-pill-new">✦ New</span>
            <span class="sg-pill sg-pill-upcoming">Upcoming</span>
            <span class="sg-pill sg-pill-draft">Draft</span>
          </div>
          <p class="style-code">.pill .pill-{variant}</p>
        </div>
      </div>
    </section>

    <!-- ─── CARDS ─── -->
    <section class="style-section" id="cards">
      <h2 class="style-section-title">Cards</h2>
      
      <div class="style-grid" style="grid-template-columns: 1fr 1fr;">
        <div class="sg-card">
          <div class="sg-card-header">
            <span class="sg-card-id">P–01</span>
            <span class="sg-badge sg-badge-active">Active</span>
          </div>
          <h3 class="sg-card-title">Digital Archives Initiative</h3>
          <p class="sg-card-subtitle">Dr. Jane Smith + 3 others</p>
          <p class="sg-card-excerpt">A multi-year project exploring the preservation of born-digital cultural heritage through distributed ledger technologies.</p>
          <div class="sg-card-meta">
            <span><span class="sg-card-meta-number">12</span> installments</span>
            <span style="margin-left: auto;">[tag] [tag]</span>
          </div>
        </div>
        
        <div class="sg-card">
          <div class="sg-card-header">
            <span class="sg-card-id">P–02</span>
            <span class="sg-badge sg-badge-new">New</span>
          </div>
          <h3 class="sg-card-title">Incomplete Manuscripts</h3>
          <p class="sg-card-subtitle">Dr. John Doe</p>
          <p class="sg-card-excerpt">A study of unfinished literary manuscripts and what they reveal about creative processes.</p>
          <div class="sg-card-meta">
            <span><span class="sg-card-meta-number">3</span> installments</span>
            <span style="margin-left: auto;">[tag] [tag]</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── TAGS ─── -->
    <section class="style-section" id="tags">
      <h2 class="style-section-title">Tags</h2>
      
      <div class="style-item">
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
          <span class="sg-tag">Archives</span>
          <span class="sg-tag">Digital Humanities</span>
          <span class="sg-tag">Memory Studies</span>
          <span class="sg-tag">Media Theory</span>
          <span class="sg-tag-more">+3</span>
        </div>
        <p class="style-code">.tag .tag-more</p>
      </div>
    </section>

    <!-- ─── LINKS ─── -->
    <section class="style-section" id="links">
      <h2 class="style-section-title">Links</h2>
      
      <div class="style-grid">
        <div class="style-item">
          <h3 class="style-label">Standard Link</h3>
          <a href="#" class="sg-link">Read more about this project →</a>
          <p class="style-code">.link-underline</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Mono Link</h3>
          <a href="#" class="sg-link-mono">View all installments →</a>
          <p class="style-code">.link-mono</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Back Link</h3>
          <button class="sg-back-link">← Back to all seasons</button>
          <p class="style-code">.back-link</p>
        </div>
      </div>
    </section>

    <!-- ─── BREADCRUMB ─── -->
    <section class="style-section" id="breadcrumb">
      <h2 class="style-section-title">Breadcrumb</h2>
      
      <div class="sg-breadcrumb">
        <a href="#">Home</a>
        <span class="sg-crumb-sep">/</span>
        <a href="#">Projects</a>
        <span class="sg-crumb-sep">/</span>
        <span class="sg-crumb-current">Digital Archives Initiative</span>
      </div>
      <p class="style-code">.breadcrumb .crumb-current .crumb-sep</p>
    </section>

    <!-- ─── HEADERS ─── -->
    <section class="style-section" id="headers">
      <h2 class="style-section-title">Section Headers</h2>
      
      <div class="style-item">
        <div class="sg-section-header">
          <h3 class="sg-section-title">Current Projects</h3>
          <span class="sg-section-meta">4 active</span>
        </div>
        <p class="style-code">.section-header .section-title .section-meta</p>
      </div>
      
      <div class="style-item">
        <div class="sg-col-head">
          <span class="sg-col-head-title">Installments</span>
          <span class="sg-col-head-meta">24 total · Season 01</span>
        </div>
        <p class="style-code">.col-head .col-head-title .col-head-meta</p>
      </div>
    </section>

    <!-- ─── GRIDS ─── -->
    <section class="style-section" id="grids">
      <h2 class="style-section-title">Grids</h2>
      
      <div class="style-item">
        <h3 class="style-label">2-Column Grid</h3>
        <div class="sg-grid-2">
          <div class="sg-grid-item">Item 1</div>
          <div class="sg-grid-item">Item 2</div>
        </div>
        <p class="style-code">.grid-2</p>
      </div>
      
      <div class="style-item">
        <h3 class="style-label">3-Column Grid</h3>
        <div class="sg-grid-3">
          <div class="sg-grid-item">Item 1</div>
          <div class="sg-grid-item">Item 2</div>
          <div class="sg-grid-item">Item 3</div>
        </div>
        <p class="style-code">.grid-3</p>
      </div>
    </section>

    <!-- ─── SPACING ─── -->
    <section class="style-section" id="spacing">
      <h2 class="style-section-title">Spacing Utilities</h2>
      
      <div class="style-grid">
        <div class="style-item">
          <h3 class="style-label">Margin</h3>
          <div class="sg-spacing-container">
            <div class="sg-spacing-demo sg-mt-sm">.mt-sm <span class="sg-spacing-value">0.25rem</span></div>
            <div class="sg-spacing-demo sg-mt-md">.mt-md <span class="sg-spacing-value">1rem</span></div>
            <div class="sg-spacing-demo sg-mt-lg">.mt-lg <span class="sg-spacing-value">1.5rem</span></div>
            <div class="sg-spacing-demo sg-mt-xl">.mt-xl <span class="sg-spacing-value">2.5rem</span></div>
          </div>
          <p class="style-code">.mt-{sm|md|lg|xl}</p>
        </div>
        
        <div class="style-item">
          <h3 class="style-label">Padding</h3>
          <div class="sg-spacing-container">
            <div class="sg-spacing-demo sg-p-sm">.p-sm <span class="sg-spacing-value">0.25rem</span></div>
            <div class="sg-spacing-demo sg-p-md">.p-md <span class="sg-spacing-value">1rem</span></div>
            <div class="sg-spacing-demo sg-p-lg">.p-lg <span class="sg-spacing-value">1.5rem</span></div>
            <div class="sg-spacing-demo sg-p-xl">.p-xl <span class="sg-spacing-value">2.5rem</span></div>
          </div>
          <p class="style-code">.p-{sm|md|lg|xl}</p>
        </div>
      </div>
    </section>

    <!-- ─── INTERACTIVE COMPONENTS ─── -->
    <section class="style-section" id="interactive">
      <h2 class="style-section-title">Interactive Components</h2>
      
      <div class="style-grid">
        <!-- Card Hover -->
        <div class="style-item">
          <h3 class="style-label">Card Hover</h3>
          <div class="sg-card sg-interactive-card">
            <div class="sg-card-header">
              <span class="sg-card-id">P–01</span>
              <span class="sg-badge sg-badge-active">Active</span>
            </div>
            <h3 class="sg-card-title">Hover me</h3>
            <p class="sg-card-subtitle">Dr. Jane Smith</p>
            <p class="sg-card-excerpt">Hover over this card to see the interactive effect.</p>
            <div class="sg-card-meta">
              <span><span class="sg-card-meta-number">12</span> installments</span>
            </div>
          </div>
          <p class="style-code">.sg-card:hover → border-color: var(--gold-dim) · transform: translateY(-3px)</p>
        </div>

        <!-- Buttons -->
        <div class="style-item">
          <h3 class="style-label">Buttons</h3>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
            <button class="sg-btn sg-btn-primary">Primary</button>
            <button class="sg-btn sg-btn-secondary">Secondary</button>
            <button class="sg-btn sg-btn-outline">Outline</button>
          </div>
          <p class="style-code">.sg-btn:hover → background/color transition</p>
        </div>

        <!-- Links -->
        <div class="style-item">
          <h3 class="style-label">Link Hover</h3>
          <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
            <a href="#" class="sg-link sg-interactive-link">Standard link</a>
            <a href="#" class="sg-link-mono sg-interactive-link">Mono link</a>
          </div>
          <p class="style-code">.sg-link:hover → color: var(--gold) · border-color: var(--gold-dim)</p>
        </div>

        <!-- Accordion -->
        <div class="style-item">
          <h3 class="style-label">Accordion</h3>
          <details class="sg-details">
            <summary>Click to expand</summary>
            <div>
              <p>This is expandable content. Click the summary again to collapse.</p>
              <ul>
                <li>• Interactive demo</li>
                <li>• Shows toggle behavior</li>
                <li>• Works with details/summary</li>
              </ul>
            </div>
          </details>
          <p class="style-code">details[open] → shows content · summary::after → + / −</p>
        </div>

        <!-- Tooltip -->
        <div class="style-item">
          <h3 class="style-label">Tooltip</h3>
          <div style="padding: 1rem 0;">
            <span class="sg-tooltip" data-tooltip="This is a tooltip!">
              Hover over me
            </span>
          </div>
          <p class="style-code">::before + ::after on hover → shows tooltip</p>
        </div>

        <!-- Tags -->
        <div class="style-item">
          <h3 class="style-label">Tag Hover</h3>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <span class="sg-tag sg-interactive-tag">Archives</span>
            <span class="sg-tag sg-interactive-tag">Digital Humanities</span>
            <span class="sg-tag sg-interactive-tag">Memory Studies</span>
          </div>
          <p class="style-code">.sg-tag:hover → border-color: var(--gold-dim)</p>
        </div>
      </div>
    </section>

  </div>
</div>

<style>
/* ─── STYLE GUIDE NAVIGATION ─── */

.style-toc {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 1.5rem;
  padding: 1rem 1.5rem;
  border: 1px solid var(--rule);
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.02);
  margin: 1.5rem var(--gutter) 0;
}

.style-toc-label {
  font-family: var(--mono);
  font-size: 7px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ash);
  margin-right: 0.5rem;
}

.style-toc a {
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  padding-bottom: 2px;
  transition: all 0.2s ease;
}

.style-toc a:hover {
  color: var(--cream);
  border-color: var(--gold-dim);
}

/* ─── STYLE GUIDE BODY ─── */

.style-guide-body {
  padding: 2rem var(--gutter) 4rem;
  max-width: 1200px;
  margin: 0 auto;
}

.style-section {
  margin: 3rem 0 4rem 0;
  scroll-margin-top: 60px;
}

.style-section-title {
  font-family: var(--display);
  font-size: 28px;
  font-style: italic;
  font-weight: 700;
  color: var(--bright);
  margin-bottom: 1.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 2px solid var(--rule-mid);
}

.style-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}

.style-grid-badges {
  grid-template-columns: 1fr;
}

.style-item {
  padding: 1.25rem;
  border: 1px solid var(--rule);
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.02);
}

.style-label {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ash);
  margin-bottom: 0.75rem;
}

.style-preview {
  margin: 0.5rem 0;
}

.display-preview {
  font-family: var(--display);
  font-size: 32px;
  font-style: italic;
  font-weight: 700;
}

.text-preview {
  font-family: var(--text);
  font-size: 16px;
}

.mono-preview {
  font-family: var(--mono);
  font-size: 14px;
}

.script-preview {
  font-family: var(--script);
  font-size: 24px;
  color: var(--gold);
}

.style-code {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--mid);
  margin-top: 0.75rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--rule);
  opacity: 0.7;
}

.style-badge-row {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  align-items: center;
}

/* ─── COLOR SWATCHES ─── */
.color-swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  border-radius: 6px;
  border: 1px solid var(--rule);
  font-family: var(--mono);
  font-size: 9px;
  gap: 0.3rem;
  min-height: 80px;
}

.color-name {
  font-weight: 700;
}

.color-hex {
  opacity: 0.6;
  font-size: 8px;
}

/* ─── STYLE GUIDE BADGES ─── */
.sg-badge {
  display: inline-block;
  font-family: var(--mono);
  font-size: 7px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.15rem 0.6rem;
  border-radius: 2px;
  border: 1px solid;
  background: transparent;
}

.sg-badge-active {
  color: #4CAF50;
  border-color: rgba(76, 175, 80, 0.3);
  background: rgba(76, 175, 80, 0.05);
}

.sg-badge-on-hold {
  color: #FFB74D;
  border-color: rgba(255, 183, 77, 0.3);
  background: rgba(255, 183, 77, 0.05);
}

.sg-badge-archived {
  color: #9E9E9E;
  border-color: rgba(158, 158, 158, 0.2);
  background: rgba(158, 158, 158, 0.05);
  opacity: 0.7;
}

.sg-badge-new {
  color: var(--gold);
  border-color: var(--gold-dim);
  background: rgba(255, 215, 0, 0.05);
}

.sg-badge-first {
  color: #64B5F6;
  border-color: rgba(100, 181, 246, 0.2);
  background: rgba(100, 181, 246, 0.08);
}

.sg-badge-revised {
  color: #CE93D8;
  border-color: rgba(206, 147, 216, 0.2);
  background: rgba(206, 147, 216, 0.08);
}

.sg-badge-last {
  color: #FF8A65;
  border-color: rgba(255, 138, 101, 0.2);
  background: rgba(255, 138, 101, 0.08);
}

/* ─── STYLE GUIDE PILLS ─── */
.sg-pill {
  display: inline-block;
  font-family: var(--mono);
  font-size: 7px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.15rem 0.8rem;
  border-radius: 9999px;
  border: 1px solid;
}

.sg-pill-live {
  color: var(--sage);
  border-color: var(--sage-dim);
  background: rgba(76, 175, 80, 0.05);
}

.sg-pill-new {
  color: var(--gold);
  border-color: var(--gold-dim);
  background: rgba(255, 215, 0, 0.05);
}

.sg-pill-upcoming {
  color: var(--rust);
  border-color: var(--ash);
}

.sg-pill-draft {
  color: var(--muted);
  border-color: var(--ash);
  opacity: 0.6;
}

/* ─── STYLE GUIDE CARDS ─── */
.sg-card {
  display: block;
  padding: 1.25rem;
  border: 1px solid var(--rule);
  border-radius: 6px;
  text-decoration: none;
  color: inherit;
  background: rgba(255, 255, 255, 0.01);
  transition: all 0.25s ease;
}

.sg-card:hover {
  border-color: var(--gold-dim);
  background: rgba(255, 255, 255, 0.03);
  transform: translateY(-3px);
}

.sg-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.sg-card-id {
  font-family: var(--mono);
